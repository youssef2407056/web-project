
<%- include("../partials/head", {
  title: "Admin Dashboard · Noir Perfume",
  bodyClass: "page-admin",
  cssFiles: ["Common.css", "Home.css", "admin.css"]
}) %>

<%- include("../partials/navbar", { activePage: "admin", navbarClass: "scrolled" }) %>

<main class="admin-page">
  <section class="admin-hero">
    <h1>Admin dashboard</h1>
    <% if (typeof isSuperAdmin !== "undefined" && isSuperAdmin) { %>
      <p>Manage products, orders, and user accounts for Noir Perfume.</p>
    <% } else { %>
      <p>Manage products and orders for Noir Perfume.</p>
    <% } %>
  </section>

  <%- include("../partials/messages") %>

  <section class="admin-stats">
    <div class="admin-stat">
      <span class="admin-stat__label">Products</span>
      <span class="admin-stat__value"><%= typeof productsCount !== "undefined" ? productsCount : 0 %></span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat__label">Orders</span>
      <span class="admin-stat__value"><%= typeof ordersCount !== "undefined" ? ordersCount : 0 %></span>
    </div>
    <% if (typeof isSuperAdmin !== "undefined" && isSuperAdmin) { %>
      <div class="admin-stat">
        <span class="admin-stat__label">Users</span>
        <span class="admin-stat__value"><%= typeof usersCount !== "undefined" ? usersCount : 0 %></span>
      </div>
    <% } %>
  </section>

  <section class="admin-cards">
    <a class="admin-card" href="/admin/products">
      <h2>Products</h2>
      <p>Add, edit, and delete products with full details.</p>
    </a>

    <a class="admin-card" href="/admin/orders">
      <h2>Orders</h2>
      <p>Review customer orders and statuses.</p>
    </a>

    <% if (typeof isSuperAdmin !== "undefined" && isSuperAdmin) { %>
      <a class="admin-card" href="/admin/users">
        <h2>Users</h2>
        <p>Add, edit, remove accounts, and assign admin roles.</p>
      </a>
      <a class="admin-card" href="/admin/promos">
        <h2>Promo codes</h2>
        <p>Create and manage checkout discount codes.</p>
      </a>
    <% } %>
  </section>
</main>

<%- include("../partials/adminFooter") %>
