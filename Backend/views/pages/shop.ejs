<%- include("../partials/head", {
  title: pageTitle || "Noir Perfume · Shop",
  cssFiles: ["Common.css", "Home.css", "shop.css", "shop-filters.css"],
  bodyData: {
    "shop-kind": selectedCategory || "shopall",
    "brand": selectedBrand || "",
    "shop-collections": selectedBrand ? "1" : ""
  }
}) %>

<%- include("../partials/navbar", { activePage: "shop", navbarClass: "scrolled" }) %>

<div class="shop-layout">
  <aside class="filters-sidebar">
    <h3 class="filters-sidebar__title">
      <% if (selectedBrand) { %>
        Filters · <%= selectedBrandLabel %>
      <% } else { %>
        Filters
      <% } %>
    </h3>

    <details class="filter-dropdown filter-group filter-group--collection" open>
      <summary class="filter-dropdown__toggle">
        <span>Categories</span>
        <i class="fa-solid fa-chevron-down filter-dropdown__arrow" aria-hidden="true"></i>
      </summary>
      <div class="filter-dropdown__panel">
        <div class="filter-collection filter-collection--radios">
          <label class="filter-radio">
            <input type="radio" name="collectionFilter" value="all" <%= !selectedCategory || selectedCategory === "shopall" || selectedCategory === "all" ? "checked" : "" %>>
            All shop
          </label>
          <label class="filter-radio">
            <input type="radio" name="collectionFilter" value="men" <%= selectedCategory === "men" ? "checked" : "" %>>
            Men
          </label>
          <label class="filter-radio">
            <input type="radio" name="collectionFilter" value="women" <%= selectedCategory === "women" ? "checked" : "" %>>
            Women
          </label>
          <label class="filter-radio">
            <input type="radio" name="collectionFilter" value="unisex" <%= selectedCategory === "unisex" ? "checked" : "" %>>
            Unisex
          </label>
        </div>
      </div>
    </details>

    <details class="filter-dropdown filter-group" open>
      <summary class="filter-dropdown__toggle">
        <span>Search</span>
        <i class="fa-solid fa-chevron-down filter-dropdown__arrow" aria-hidden="true"></i>
      </summary>
      <div class="filter-dropdown__panel">
        <input type="text" id="searchInput" placeholder="Search perfumes…" autocomplete="off">
      </div>
    </details>

    <details class="filter-dropdown filter-group" open>
      <summary class="filter-dropdown__toggle">
        <span>Price</span>
        <i class="fa-solid fa-chevron-down filter-dropdown__arrow" aria-hidden="true"></i>
      </summary>
      <div class="filter-dropdown__panel">
        <div class="price-range">
          <input type="number" id="priceMin" placeholder="Min" step="100" inputmode="numeric">
          <input type="number" id="priceMax" placeholder="Max" step="100" inputmode="numeric">
        </div>
      </div>
    </details>

    <details class="filter-dropdown filter-group" open>
      <summary class="filter-dropdown__toggle">
        <span>Availability</span>
        <i class="fa-solid fa-chevron-down filter-dropdown__arrow" aria-hidden="true"></i>
      </summary>
      <div class="filter-dropdown__panel">
        <label class="filter-check-label">
          <input type="checkbox" id="inStock">
          In stock only
        </label>
      </div>
    </details>

    <button type="button" class="clear-filters" onclick="resetFilters()">Clear filters</button>
  </aside>

  <div class="products-area">
    <div class="results-count" id="resultsCount"></div>
    <div class="products-grid" id="productsGrid"></div>
  </div>
</div>

<%- include("../partials/searchModal") %>
<%- include("../partials/cartDrawer") %>

<%- include("../partials/footer", {
  jsFiles: ["products-catalog.js", "shop.js", "quick-view-modal.js", "shop-filters.js", "nav-search.js", "home.js"]
}) %>
