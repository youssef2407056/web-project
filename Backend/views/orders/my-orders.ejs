
<%- include("../partials/head", {
  title: "My Orders · Noir Perfume",
  cssFiles: ["Common.css", "Home.css", "shop.css"]
}) %>

<%- include("../partials/navbar", { activePage: "orders" }) %>

<main class="favorites-page">
  <h1>My Orders</h1>
  <p class="sub">Track your previous Noir Perfume orders.</p>

  <%- include("../partials/messages") %>

  <% if (!orders || orders.length === 0) { %>
    <div class="fav-list">
      <p class="empty-msg">You have no orders yet.</p>
    </div>
  <% } else { %>
    <div class="fav-list">
      <% orders.forEach(order => { %>
        <div class="fav-row">
          <div>
            <strong>#<%= order._id.toString().slice(-8).toUpperCase() %></strong>
            <% if (order.lineItems && order.lineItems.length) { %>
              <ul class="my-order-items">
                <% order.lineItems.forEach(function(line) { %>
                  <li>
                    <%= line.name || "Product" %>
                    <% if (line.sizeMl) { %> · <%= line.sizeMl %> ml<% } %>
                    × <%= line.quantity || 1 %>
                  </li>
                <% }) %>
              </ul>
            <% } else if (order.products && order.products.length) { %>
              <ul class="my-order-items">
                <% order.products.forEach(function(item) { %>
                  <li>
                    <%= item.product && item.product.name ? item.product.name : "Product" %>
                    × <%= item.quantity %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
            <p>Status: <%= order.status %></p>
            <p>Total: <span class="noir-money" data-egp="<%= Number(order.totalPrice) %>">LE <%= Number(order.totalPrice).toLocaleString("en-US") %></span></p>
            <p><%= new Date(order.createdAt).toLocaleDateString("en-GB") %></p>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include("../partials/searchModal") %>
<%- include("../partials/cartDrawer") %>
<%- include("../partials/footer", {
  jsFiles: ["products-catalog.js", "shop.js", "quick-view-modal.js", "nav-search.js", "home.js"]
}) %>
